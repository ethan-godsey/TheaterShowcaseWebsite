# Cognito identifiers. NOT secrets — Vite bakes VITE_* vars into the built
# bundle, and these two are public by design (the pool ID and client ID appear
# in every authorize URL the browser navigates to). Committed deliberately so
# builds work anywhere without extra setup.
VITE_COGNITO_DOMAIN=https://us-east-1vep6zbjih.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=ddfudshe7ahe9bgf9msv43de4
